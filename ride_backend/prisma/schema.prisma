generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model users {
  id            Int      @id @default(autoincrement())
  google_id     String?  @unique @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false)
  name          String?  @db.VarChar(255)
  picture       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  isadmin       Boolean? @default(false)

  rides        rides[]       @relation("UserRides")
  sentRequests requests[]    @relation("UserRequests")
  groupChats   groupChat[]   @relation("UserChats")
  authSessions authSession[]
  accounts     account[]
}

model authSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                Int
  user                  users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model rides {
  rideID         Int    @id @default(autoincrement())
  createdBy      Int
  source         String @db.VarChar(255)
  destination    String @db.VarChar(255)
  date           String @db.VarChar(255)
  time           String @db.VarChar(255)
  seatsAvailable Int
  totalSeats     Int?
  totalCost      Float?
  vehicleType    String @db.VarChar(255)
  rideStatus     String @default("Pending") @db.VarChar(50)

  creator    users       @relation("UserRides", fields: [createdBy], references: [id], onDelete: Cascade)
  requests   requests[]
  groupChats groupChat[]

  @@index([rideStatus, date, time, rideID])
}

model requests {
  id            Int    @id @default(autoincrement())
  rideID        Int
  createdBy     Int
  requestBy     Int
  rideStatus    String @db.VarChar(50)
  requestStatus String @default("Pending") @db.VarChar(50)

  ride      rides @relation(fields: [rideID], references: [rideID], onDelete: Cascade)
  requester users @relation("UserRequests", fields: [requestBy], references: [id], onDelete: Cascade)

  @@unique([rideID, requestBy])
}

model groupChat {
  id          Int     @id @default(autoincrement())
  rideID      Int
  rideOwner   String? @db.VarChar(255)
  messageBy   Int
  message     String  @db.Text
  messageTime String  @db.VarChar(255)
  messageDate String  @db.VarChar(255)

  ride   rides @relation(fields: [rideID], references: [rideID], onDelete: Cascade)
  sender users @relation("UserChats", fields: [messageBy], references: [id], onDelete: Cascade)
}
